extends ../layouts/default.pug

block main
    h1.box-title Quản lý tin tức

    //- Section 4
    .section-4
      .inner-wrap
        .inner-item.inner-label
          <i class="fa-solid fa-filter"></i> Bộ lọc
        .inner-item
          select(filter-status)
            option(value="") Trạng thái
            option(value="active") Hoạt động
            option(value="inactive") Tạm dừng
        .inner-item
          select(filter-created-by)
            option(value="") Người tạo
            each item in accountAdminList
              option(value=item.id) #{item.fullName}
        .inner-item.inner-reset(filter-reset)
          <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
    //- End Section 4

    //- Section 5
    .section-5
      .inner-wrap
        .inner-change-status(
          change-multi
          data-api=`/${pathAdmin}/article/change-multi`
        )
          .inner-item
            select
              option(value="") -- Hành động --
              option(value="active") Hoạt động
              option(value="inactive") Dừng hoạt động
              option(value="delete") Xóa
          .inner-item
            button Áp dụng
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Tìm kiếm" search)
        .inner-button-create
            a(href=`/${pathAdmin}/article/create`) + Tạo mới
        .inner-button-trash
            a(href=`/${pathAdmin}/article/trash`) Thùng rác
    //- End Section 5

    //- Section 6
    .section-6
      .table-2
        table
          thead
            tr
              th(class="inner-center")
                input(type="checkbox" class="inner-check" check-all)
              th Tiêu đề
              th Ảnh đại diện
              th(class="inner-center") Vị trí
              th(class="inner-center") Trạng thái
              th Tạo bởi
              th Cập nhật bởi
              th Hành động
          tbody
            each item in articleList
              tr
                td(class="inner-center")
                  input(type="checkbox" class="inner-check" check-item=item.id)
                td #{item.title}
                td
                  img(src=item.avatar class="inner-avatar" style="width:80px;height:auto;border-radius:4px;")
                td(class="inner-center") #{item.position}
                td(class="inner-center")
                  if (item.status == "active")
                    .badge.badge-green Hoạt động
                  else if (item.status == "inactive")
                    .badge.badge-red Tạm dừng
                td
                  div #{item.createdByFullName}
                  div.inner-time #{item.createdAtFormat}
                td
                  div #{item.updatedByFullName}
                  div.inner-time #{item.updatedAtFormat}
                td
                  .inner-buttons
                      a(
                        href=`/${pathAdmin}/article/edit/${item.id}`
                        class="inner-edit"
                      ) <i class="fa-regular fa-pen-to-square"></i>
                      button(
                        class="inner-delete"
                        button-delete
                        data-api=`/${pathAdmin}/article/delete/${item.id}`
                      ) <i class="fa-regular fa-trash-can"></i>
    //- End Section 6

    //- Section 7`
    .section-7
      span(class="inner-label") Hiển thị #{articleList.length>0 ? pagination.skip + 1 :0} - #{pagination.skip + articleList.length} của #{pagination.totalRecord}
      select(class="inner-pagination" pagination)
        - for (let i = 1; i <= pagination.totalPage; i++)
          option(value=i selected=(i == pagination.currentPage ? true : false)) Trang #{i}
    //- End Section 7
