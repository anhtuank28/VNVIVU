extends ../layouts/account.pug

block main
  .form-account
    h2.inner-title Nhập mã OTP
    p.inner-desc
      if email
        | Mã OTP đã được gửi đến email <b>#{email}</b>. Vui lòng nhập mã để tiếp tục (hiệu lực 5 phút).
      else
        | Vui lòng nhập mã OTP để tiếp tục (hiệu lực trong 5 phút).
    
    form.inner-form#otp-password-form
      input(
        type="hidden"
        name="email"
        id="email"
        value=email
      )
      .inner-group
        label(
          class="inner-label"
          for="otp"
        ) Mã OTP (6 chữ số)
        input(
          type="text"
          name="otp"
          id="otp"
          placeholder="Ví dụ: 123456"
          maxlength="6"
          class="inner-control"
        )
      button(class="inner-button", type="submit") Xác nhận OTP
    
    .inner-more
      span Bạn đã nhớ mật khẩu?
      a(
        href=`/${pathAdmin}/account/login`
      ) Đăng nhập