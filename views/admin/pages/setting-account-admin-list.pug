extends ../layouts/default.pug

block main
  h1.box-title Tài khoản quản trị

  //- Section 4
  .section-4
    .inner-wrap
      .inner-item.inner-label
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        select
          option(value="") Trạng thái
          option(value="") Hoạt động
          option(value="") Tạm dừng
      .inner-item.inner-date
        input(type="date")
        span -
        input(type="date")
      .inner-item
        select
          option(value="") Nhóm quyền
          option(value="") Quản trị viên
          option(value="") Quản lý tour
          option(value="") Quản lý đơn hàng
      .inner-item.inner-reset
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5
    .inner-wrap
      if(permissions.includes('account-edit'))
        .inner-change-status
          .inner-item
            select
              option(value="") -- Hành động --
              option(value="") Hoạt động
              option(value="") Dừng hoạt động
              option(value="") Xóa
          .inner-item
            button Áp dụng
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm")
      if(permissions.includes('account-create'))
        .inner-button-create
          a(href=`/${pathAdmin}/setting/account-admin/create`) + Tạo mới
  //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th(class="inner-center")
              input(type="checkbox" class="inner-check")
            th Họ tên
            th(class="inner-center") Ảnh đại diện
            th Email
            th Số điện thoại
            th Nhóm quyền
            th Chức vụ
            th Trạng thái
            if(permissions.includes('account-edit') || permissions.includes('account-delete'))
              th Hành động
        tbody
          each item in accountAdminList
            tr
              td(class="inner-center")
                input(type="checkbox" class="inner-check")
              td #{item.fullName}
              td(class="inner-center")
                img(src=item.avatar class="inner-avatar")
              td #{item.email}
              td #{item.phone}
              td #{item.roleName}
              td #{item.positionCompany}
              td
                if (item.status == "active")
                  .badge.badge-green Hoạt động
                else if(item.status == "inactive")
                  .badge.badge-red Tạm dừng
                else if(item.status == "initial")
                  .badge.badge-orange Khởi tạo
              if(permissions.includes('account-edit') || permissions.includes('account-delete'))
                td
                  .inner-buttons
                    if(permissions.includes('account-edit'))
                      a(
                        href=`/${pathAdmin}/setting/account-admin/edit/${item.id}` 
                        class="inner-edit"
                      ) <i class="fa-regular fa-pen-to-square"></i>
                    if(permissions.includes('account-delete'))
                      button(
                        class="inner-delete"
                        button-delete 
                        data-api=`/${pathAdmin}/setting/account-admin/delete/${item.id}`
                      ) <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  if (pagination)
    .section-7
      span(class="inner-label") Hiển thị #{accountAdminList.length>0 ? pagination.skip + 1 :0} - #{pagination.skip + accountAdminList.length} của #{pagination.totalRecord}
      select(class="inner-pagination" pagination)
        - for (let i = 1; i <= pagination.totalPage; i++)
          option(value=i selected=(i == pagination.currentPage ? true : false)) Trang #{i}
  //- End Section 7